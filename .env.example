# Postgres connection string used by Drizzle and session storage
DATABASE_URL=postgresql://user:password@localhost:5432/enerjee

# Secret for signing Express session cookies
SESSION_SECRET=change-me-session-secret

# OpenAI-compatible API endpoint configuration
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key-here
